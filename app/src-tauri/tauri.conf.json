{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "cyanomelody",
  "version": "1.1.2",
  "identifier": "dev.cyanomelody.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "cyanomelody",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "createUpdaterArtifacts": true,
    "publisher": "Taniguchi-EX",
    "shortDescription": "音声ファイルにタグを付けて整理し、プレイリストで再生するアプリ",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Japanese"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY5REFFRjM4MTlDOUE2OTkKUldTWnBza1pPTy9hYVpQTjJLZk52UnRNbHg5U1F6OUtKMFF1WUQvNmMxVHhoS0gzSGhyS0pZZUEK",
      "endpoints": [
        "https://github.com/Taniguchi-EX/cyanomelody/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
